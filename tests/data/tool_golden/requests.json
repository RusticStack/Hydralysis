    {"id": "sys-inspect-entry", "requires": {"file": "{SYSEXE}", "sha256": "23240ef9f8b0a9a324110b1c2331de31dc1b0e08f5359cb707e51a939af56cd3"}, "tool": "inspect", "arguments": {"exe": "{SYSEXE}", "address": "rva:0x1cb0"}},
