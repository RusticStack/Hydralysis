    {"id": "dispatch-count-bool", "tool": "disasm", "arguments": {"exe": "{FIXTURE}", "address": "rva:0x1000", "count": true}},
    {"id": "dispatch-size-too-big", "tool": "bytes", "arguments": {"exe": "{FIXTURE}", "address": "rva:0x1000", "size": 65537}},

