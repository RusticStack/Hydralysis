{
  "format": "hydralysis-tool-golden/1",
  "description": "Requests driven over the MCP stdio wire by tests/tool_golden.py. Steps run in order, one at a time. record=false steps run without a recorded reply. requires guards a step on a file that must have the given sha256 (otherwise the step is recorded as skipped). await_job polls the job id the reply names until it is no longer active (not recorded). $ref:<step>.<key> takes a key of an earlier JSON reply. {FIXTURE}, {SYSEXE}, {WORK}, {TARGET} are placeholders. The synthetic PE tests/data/tool_golden/fixtures/cc_issues_pe.exe is generated by make_pe in hydra-engine's Ghidra/Features/HeadlessSession/examples/cc_issues_eng.py (3524 bytes; entry VA 0x140001000 = RVA 0x1000).",
  "excluded": [
    {"tool": "backend", "action": "install", "reason": "starts a durable install job and writes the client into the root (side effect)"},
    {"tool": "backend", "action": "stop", "reason": "stops the shared engine; only the harness teardown sends it, unrecorded"},
    {"tool": "runtime", "action": "setup|spawn|attach|continue|step|write|detach", "reason": "start or act on a live process of this machine; only error paths and read-only calls are recorded"},
    {"tool": "trace", "action": "start|resymbolize|reprocess|relations|evict (with a session)", "reason": "capture runs through runtime; the engine jobs need a recorded runtime session"},
    {"tool": "ghidra_query", "action": "export", "reason": "starts a bulk export job that writes artifacts"},
    {"tool": "ghidra_query", "action": "type_edit", "reason": "writes an overlay (cited working copy); the write path is not golden-recorded"},
    {"tool": "ghidra_query", "action": "stop", "reason": "stops engine work of the target; left to the engine's own tests"},
    {"tool": "ghidra_query", "action": "trace|diff", "reason": "needs a second analysed target or a recorded trace session"},
    {"tool": "ghidra_run", "options": "a successful run", "reason": "needs a user script installed in the userscripts folder; only the contained-mode error and option checks are recorded"},
    {"tool": "job", "action": "cancel of a running job", "reason": "cancels engine work; only the no-id and unknown-id errors are recorded"},
    {"tool": "prepare", "action": "adopt with a real .gpr", "reason": "needs an analysed project; only the missing-path error is recorded"},
    {"tool": "prompts/list, resources/list", "reason": "covered as raw methods"}
  ],
  "steps": [
    {"id": "fp-header", "tool": "fingerprint", "arguments": {"exe": "{FIXTURE}"}},
    {"id": "fp-sections", "tool": "fingerprint", "arguments": {"exe": "{FIXTURE}", "detail": "sections"}},
    {"id": "fp-exports", "tool": "fingerprint", "arguments": {"exe": "{FIXTURE}", "detail": "exports"}},
    {"id": "fp-bad-detail", "tool": "fingerprint", "arguments": {"exe": "{FIXTURE}", "detail": "resources"}},
    {"id": "fp-missing-exe", "tool": "fingerprint", "arguments": {"exe": "{WORK}/absent.exe"}},
    {"id": "fp-no-exe", "tool": "fingerprint", "arguments": {}},

    {"id": "imports-all", "tool": "imports", "arguments": {"exe": "{FIXTURE}", "limit": 20}},
    {"id": "imports-pattern", "tool": "imports", "arguments": {"exe": "{FIXTURE}", "pattern": "Kernel", "limit": 5}},

    {"id": "disasm-va", "tool": "disasm", "arguments": {"exe": "{FIXTURE}", "address": "va:0x140001000", "count": 4}},
    {"id": "disasm-rva", "tool": "disasm", "arguments": {"exe": "{FIXTURE}", "address": "rva:0x1000", "count": 4}},
    {"id": "disasm-ambiguous", "tool": "disasm", "arguments": {"exe": "{FIXTURE}", "address": "0x140001000", "count": 2}},
    {"id": "disasm-count-bad", "tool": "disasm", "arguments": {"exe": "{FIXTURE}", "address": "rva:0x1000", "count": 0}},

    {"id": "inspect-va", "tool": "inspect", "arguments": {"exe": "{FIXTURE}", "address": "va:0x140001000"}},
    {"id": "inspect-outside", "tool": "inspect", "arguments": {"exe": "{FIXTURE}", "address": "rva:0x9000"}},

    {"id": "xrefs-entry", "tool": "xrefs", "arguments": {"exe": "{FIXTURE}", "address": "rva:0x1000", "limit": 5}},
    {"id": "callers-entry", "tool": "callers", "arguments": {"exe": "{FIXTURE}", "address": "rva:0x1000", "limit": 5}},
    {"id": "callees-entry", "tool": "callees", "arguments": {"exe": "{FIXTURE}", "address": "rva:0x1000", "limit": 5}},
    {"id": "function-entry", "tool": "function", "arguments": {"exe": "{FIXTURE}", "address": "rva:0x1000"}},
    {"id": "bytes-entry", "tool": "bytes", "arguments": {"exe": "{FIXTURE}", "address": "rva:0x1000", "size": 16}},
    {"id": "bytes-size-bad", "tool": "bytes", "arguments": {"exe": "{FIXTURE}", "address": "rva:0x1000", "size": 0}},
    {"id": "strings-letters", "tool": "strings", "arguments": {"exe": "{FIXTURE}", "pattern": "[A-Za-z]{4,}", "limit": 5}},
    {"id": "strings-limit-bad", "tool": "strings", "arguments": {"exe": "{FIXTURE}", "pattern": "x", "limit": 0}},
    {"id": "sigscan-entry", "tool": "sigscan", "arguments": {"exe": "{FIXTURE}", "pattern": "83 F9 ?? 0F 84", "limit": 5}},
    {"id": "sigscan-none", "tool": "sigscan", "arguments": {"exe": "{FIXTURE}", "pattern": "FF FF FF FF FF FF FF FF FF", "limit": 5}},

    {"id": "prologue-match", "tool": "prologue", "arguments": {"exe": "{FIXTURE}", "address": "rva:0x1000", "expect": "83 F9 01 0F 84 F7 00 00 00"}},
    {"id": "prologue-mismatch", "tool": "prologue", "arguments": {"exe": "{FIXTURE}", "address": "rva:0x1000", "expect": "90 90 90"}},
    {"id": "prologue-no-expect", "tool": "prologue", "arguments": {"exe": "{FIXTURE}", "address": "rva:0x1000"}},
    {"id": "prologue-sha-bad", "tool": "prologue", "arguments": {"exe": "{FIXTURE}", "address": "rva:0x1000", "expect": "83 F9 01", "sha256": "00"}},
    {"id": "prologue-table", "tool": "prologue", "arguments": {"exe": "{FIXTURE}", "checks": [
        {"address": "rva:0x1000", "expect": "83 F9 01 0F 84", "name": "entry-cmp"},
        {"address": "rva:0x1009", "expect": "83 F9 02 0F 84", "name": "second-cmp"}
    ], "sha256": "73ffdcdbc344c0d19a88f6f1b331a8dc552133f1d938d408b448b7d91d2b5b56"}},
    {"id": "prologue-table-bad", "tool": "prologue", "arguments": {"exe": "{FIXTURE}", "checks": [
        {"address": "rva:0x1000", "expect": "90 90", "name": "wrong"}
    ]}},

    {"id": "evidence-add", "tool": "evidence_add", "arguments": {
        "target": "{TARGET}", "build": "73ffdcdbc344c0d1", "kind": "function", "name": "entry_dispatch",
        "note": "entry compares its first argument with 1 and 2", "source": "tool-golden fixture bytes at rva:0x1000",
        "address": "va:0x140001000", "subsystem": "golden", "db": "{WORK}/evidence.db"}},
    {"id": "evidence-add-superseded", "tool": "evidence_add", "arguments": {
        "target": "{TARGET}", "build": "73ffdcdbc344c0d1", "kind": "function", "name": "entry_dispatch",
        "note": "same claim, restated with the byte sequence", "source": "tool-golden fixture bytes at rva:0x1000",
        "address": "va:0x140001000", "subsystem": "golden", "supersedes": 1, "db": "{WORK}/evidence.db"}},
    {"id": "evidence-add-no-source", "tool": "evidence_add", "arguments": {
        "target": "{TARGET}", "build": "73ffdcdbc344c0d1", "kind": "function", "name": "x", "note": "no source",
        "source": "", "db": "{WORK}/evidence.db"}},
    {"id": "evidence-list", "tool": "evidence_list", "arguments": {"target": "{TARGET}", "limit": 10, "db": "{WORK}/evidence.db"}},
    {"id": "evidence-list-all", "tool": "evidence_list", "arguments": {"target": "{TARGET}", "include_superseded": true, "limit": 10, "db": "{WORK}/evidence.db"}},
    {"id": "evidence-list-subsystem", "tool": "evidence_list", "arguments": {"target": "{TARGET}", "subsystem": "golden", "db": "{WORK}/evidence.db"}},
    {"id": "evidence-export", "tool": "evidence_list", "arguments": {"target": "{TARGET}", "subsystem": "golden", "export": "{WORK}/golden-claims.md", "db": "{WORK}/evidence.db"}},
    {"id": "evidence-export-relative", "tool": "evidence_list", "arguments": {"target": "{TARGET}", "export": "claims.md", "db": "{WORK}/evidence.db"}},

    {"id": "backend-inspect", "tool": "backend", "arguments": {"action": "inspect"}},
    {"id": "backend-inspect-runtime", "tool": "backend", "arguments": {"action": "inspect", "component": "runtime"}},
    {"id": "backend-help", "tool": "backend", "arguments": {"action": "help"}},
    {"id": "backend-help-runtime", "tool": "backend", "arguments": {"action": "help", "component": "runtime"}},
    {"id": "backend-status", "tool": "backend", "arguments": {"action": "status"}},
    {"id": "backend-doctor", "tool": "backend", "arguments": {"action": "doctor"}},
    {"id": "backend-backups", "tool": "backend", "arguments": {"action": "backups", "options": {"op": "list"}}},
    {"id": "backend-backups-op-bad", "tool": "backend", "arguments": {"action": "backups", "options": {"op": "wipe"}}},
    {"id": "backend-action-bad", "tool": "backend", "arguments": {"action": "reinstall"}},
    {"id": "backend-component-bad", "tool": "backend", "arguments": {"action": "inspect", "component": "android"}},

    {"id": "prepare-plan", "tool": "prepare", "arguments": {"action": "plan", "exe": "{FIXTURE}", "target": "{TARGET}"}},
    {"id": "prepare-plan-no-exe", "tool": "prepare", "arguments": {"action": "plan"}},
    {"id": "prepare-start", "tool": "prepare", "arguments": {"action": "start", "exe": "{FIXTURE}", "target": "{TARGET}"}, "await_job": true},
    {"id": "prepare-adopt-missing", "tool": "prepare", "arguments": {"action": "adopt", "path": "{WORK}/absent/project.gpr"}},
    {"id": "prepare-install-bad", "tool": "prepare", "arguments": {"action": "plan", "exe": "{FIXTURE}", "install": "yes"}},

    {"id": "job-list", "tool": "job", "arguments": {"action": "status"}},
    {"id": "job-status-prepare", "tool": "job", "arguments": {"action": "status", "id": "$ref:prepare-start.job_id"}},
    {"id": "job-status-unknown", "tool": "job", "arguments": {"action": "status", "id": "prepare-000000000000"}},
    {"id": "job-status-bad-id", "tool": "job", "arguments": {"action": "status", "id": "job-XYZ"}},
    {"id": "job-status-limit-bad", "tool": "job", "arguments": {"action": "status", "limit": 0}},
    {"id": "job-cancel-no-id", "tool": "job", "arguments": {"action": "cancel"}},
    {"id": "job-cancel-finished", "tool": "job", "arguments": {"action": "cancel", "id": "$ref:prepare-start.job_id"}},
    {"id": "job-options", "tool": "job", "arguments": {"action": "status", "options": {"kind": "commit"}}},
    {"id": "job-action-bad", "tool": "job", "arguments": {"action": "restart", "id": "$ref:prepare-start.job_id"}},

    {"id": "gq-status", "tool": "ghidra_query", "arguments": {"target": "{TARGET}", "action": "status"}},
    {"id": "gq-status-show", "tool": "ghidra_query", "arguments": {"target": "{TARGET}", "action": "status", "options": {"show": "changes"}}},
    {"id": "gq-status-show-bad", "tool": "ghidra_query", "arguments": {"target": "{TARGET}", "action": "status", "options": {"show": "health"}}},
    {"id": "gq-status-options-unknown", "tool": "ghidra_query", "arguments": {"target": "{TARGET}", "action": "status", "options": {"since": "x", "state": "y", "bogus": 1}}},
    {"id": "gq-function-va", "tool": "ghidra_query", "arguments": {"target": "{TARGET}", "action": "function", "address": "va:0x140001000"}},
    {"id": "gq-decompile-va", "tool": "ghidra_query", "arguments": {"target": "{TARGET}", "address": "va:0x140001000"}, "await_job": true},
    {"id": "gq-decompile-rva-capped", "tool": "ghidra_query", "arguments": {"target": "{TARGET}", "action": "decompile", "address": "rva:0x1000", "options": {"max_characters": 200}}, "await_job": true},
    {"id": "gq-decompile-offset", "tool": "ghidra_query", "arguments": {"target": "{TARGET}", "action": "decompile", "address": "va:0x140001000", "options": {"max_characters": 64, "offset": 16}}, "await_job": true},
    {"id": "gq-functions", "tool": "ghidra_query", "arguments": {"target": "{TARGET}", "action": "functions", "limit": 10}},
    {"id": "gq-functions-contains", "tool": "ghidra_query", "arguments": {"target": "{TARGET}", "action": "functions", "contains": "cc", "limit": 10}},
    {"id": "gq-xrefs-entry", "tool": "ghidra_query", "arguments": {"target": "{TARGET}", "action": "xrefs", "address": "va:0x140001000", "limit": 5}},
    {"id": "gq-dossier-entry", "tool": "ghidra_query", "arguments": {"target": "{TARGET}", "action": "dossier", "address": "va:0x140001000"}},
    {"id": "gq-blocks-entry", "tool": "ghidra_query", "arguments": {"target": "{TARGET}", "action": "blocks", "address": "va:0x140001000"}},
    {"id": "gq-pcode-entry", "tool": "ghidra_query", "arguments": {"target": "{TARGET}", "action": "pcode", "address": "va:0x140001000"}},
    {"id": "gq-variables-entry", "tool": "ghidra_query", "arguments": {"target": "{TARGET}", "action": "variables", "address": "va:0x140001000"}},
    {"id": "gq-data", "tool": "ghidra_query", "arguments": {"target": "{TARGET}", "action": "data", "address": "va:0x140001000", "limit": 5}},
    {"id": "gq-types", "tool": "ghidra_query", "arguments": {"target": "{TARGET}", "action": "types", "limit": 5}},
    {"id": "gq-scan", "tool": "ghidra_query", "arguments": {"target": "{TARGET}", "action": "scan", "address": "va:0x140001000", "options": {"mnemonic": "cmp"}, "limit": 5}},
    {"id": "gq-scan-regex-bad", "tool": "ghidra_query", "arguments": {"target": "{TARGET}", "action": "scan", "address": "va:0x140001000", "options": {"regex": "("}}},
    {"id": "gq-vtables", "tool": "ghidra_query", "arguments": {"target": "{TARGET}", "action": "vtables", "address": "va:0x140001000", "limit": 5}},
    {"id": "gq-vcalls", "tool": "ghidra_query", "arguments": {"target": "{TARGET}", "action": "vcalls", "address": "va:0x140001000", "options": {"offset": "0xc0"}, "limit": 5}},
    {"id": "gq-writes", "tool": "ghidra_query", "arguments": {"target": "{TARGET}", "action": "writes", "address": "va:0x140001000", "options": {"offset": "0x8"}, "limit": 5}},
    {"id": "gq-orphans", "tool": "ghidra_query", "arguments": {"target": "{TARGET}", "action": "orphans", "limit": 5}},
    {"id": "gq-name-no-map", "tool": "ghidra_query", "arguments": {"target": "{TARGET}", "address": "name:entry_dispatch"}},
    {"id": "gq-address-map-bad", "tool": "ghidra_query", "arguments": {"target": "{TARGET}", "action": "address_map", "options": {"path": 3}}},
    {"id": "gq-target-unknown", "tool": "ghidra_query", "arguments": {"target": "nope", "action": "status"}},
    {"id": "gq-action-bad", "tool": "ghidra_query", "arguments": {"target": "{TARGET}", "action": "compile"}},
    {"id": "gq-limit-bad", "tool": "ghidra_query", "arguments": {"target": "{TARGET}", "action": "functions", "limit": 0}},

    {"id": "job-list-after", "tool": "job", "arguments": {"action": "status"}},

    {"id": "run-contained-missing", "tool": "ghidra_run", "arguments": {"target": "{TARGET}", "script": "absent_script.py"}},
    {"id": "run-isolation-option", "tool": "ghidra_run", "arguments": {"target": "{TARGET}", "script": "absent_script.py", "options": {"isolation": "private"}}},
    {"id": "run-readonly-bad", "tool": "ghidra_run", "arguments": {"target": "{TARGET}", "script": "absent_script.py", "options": {"readonly": "yes"}}},
