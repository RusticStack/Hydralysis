    {"id": "sys-fp-sections", "requires": {"file": "{SYSEXE}", "sha256": "23240ef9f8b0a9a324110b1c2331de31dc1b0e08f5359cb707e51a939af56cd3"}, "tool": "fingerprint", "arguments": {"exe": "{SYSEXE}", "detail": "sections"}},
    {"id": "sys-imports", "requires": {"file": "{SYSEXE}", "sha256": "23240ef9f8b0a9a324110b1c2331de31dc1b0e08f5359cb707e51a939af56cd3"}, "tool": "imports", "arguments": {"exe": "{SYSEXE}", "pattern": "Kernel32", "limit": 10}},
