    {"id": "run-isolation-bad", "tool": "ghidra_run", "arguments": {"target": "{TARGET}", "script": "absent_script.py", "options": {"isolation": "global"}}},

    {"id": "runtime-status", "tool": "runtime", "arguments": {"action": "status"}},
    {"id": "runtime-modules-no-session", "tool": "runtime", "arguments": {"action": "modules"}},
